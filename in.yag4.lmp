#YAG
#模型的基本参数
units               metal
boundary            p p p
atom_style          charge
timestep            0.001
neighbor 0.3 bin
neigh_modify        delay 0 every 1 check yes
neigh_modify one 1000000 page 10000000

#建模
read_data           yag110_15.data

#热力学信息输出
thermo              10
thermo_style        custom step temp press pe ke

#势函数（力场）
pair_style          buck/coul/cut 2.96 10
pair_coeff          1 1 1822 0.305726302167583  100 
pair_coeff          1 2 1822 0.314623099320608 0 
pair_coeff          1 3 1822 0.258007117437722 0 
pair_coeff          2 2 1822 0.323519896473633 0 
pair_coeff          2 3 1822 0.266903914590747 0 
pair_coeff          3 3 1822 0.210287932707862 0 
pair_coeff          1 4 1822 0.23778712390812 0 
pair_coeff          2 4 1822 0.246683921061145 0 
pair_coeff          3 4 1822 0.190067939178259 0 
pair_coeff          4 4 1822 0.169847945648657 0 


# 定义区域和分组
region upper block INF INF INF INF 20 INF   # 上部区域 (Z > 5)
region lower block INF INF INF INF INF -24  # 下部区域 (Z < -5)
#region mobile block INF INF INF INF -24 24  # 中间区域 (Z -5 到 5)

# 创建分组
group upper region upper
group lower region lower
#group mobile region mobile

displace_atoms upper move 0 0 -40 units box

write_data cg.data
					   
