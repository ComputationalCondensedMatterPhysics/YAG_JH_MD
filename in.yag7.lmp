#YAG
#模型的基本参数
units               metal
boundary            p p p
atom_style          charge
timestep            0.001
neighbor 0.3 bin
neigh_modify        delay 0 every 1 check yes
neigh_modify one 1000000 page 10000000

#建模
read_data           cg.data

reset_atom_ids


pair_style          buck/coul/cut 3 10
pair_coeff          1 1 1822 0.305726302167583  100 
pair_coeff          1 2 1822 0.314623099320608 0 
pair_coeff          1 3 1822 0.258007117437722 0 
pair_coeff          2 2 1822 0.323519896473633 0 
pair_coeff          2 3 1822 0.266903914590747 0 
pair_coeff          3 3 1822 0.210287932707862 0 
pair_coeff          1 4 1822 0.23778712390812 0 
pair_coeff          2 4 1822 0.246683921061145 0 
pair_coeff          3 4 1822 0.190067939178259 0 
pair_coeff          4 4 1822 0.169847945648657 0


#热力学信息输出
compute s all stress/atom NULL
compute p all reduce sum c_s[1] c_s[2] c_s[3]
variable Press equal -(c_p[1]+c_p[2]+c_p[3])/(3*vol)

thermo              100
thermo_style custom step temp  pzz pe ke etotal v_Press 
#应力应变设置 
variable 		tmpz equal "lz"
variable 		Lz0 equal ${tmpz}
variable 		strainz equal "(v_Lz0-lz)/v_Lz0"
variable		stressz2 equal "pzz/10000"
variable 		step1 equal "step"
variable 		temp1 equal "temp"
variable 		pe1 equal "pe"
variable 		ke1 equal "ke"
variable 		vstress equal "v_Press "
#应力应变保存到文件
fix def3 all print 50 "${strainz} ${stressz2} ${step1} ${temp1} ${pe1} ${ke1} ${vstress}" file stress-strain.dat screen no


#温度初始化
velocity            all create 0 8555
minimize 1e-6 1e-6 1000 10000  # 执行一次能量最小化

delete_atoms overlap 1.5 all all

fix 1 all deform 1 z erate -0.002 units box
dump 2 all custom 200 YAG_tension.xyz id type x y z
fix a all nvt temp 1 1500 0.1
run 28650
unfix 1
unfix a
#delete_atoms overlap 0.8 all all

# 进行恒温恒压的 NPT 模拟

fix a all npt temp 1500 1500 0.1 x 0 0 1 y 0 0 1 z 1 1 1
run 40000
unfix a

write_data 110cg3.data

